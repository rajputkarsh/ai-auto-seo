# LLM — when set, the API uses the model-backed reasoner (better titles/descriptions);
# when empty, the deterministic reasoner is used. Not required for tests or the eval.
ANTHROPIC_API_KEY=
# Per-scan spend ceiling for the LLM cost governor, in cents. Default 25.
LLM_BUDGET_CENTS=

# Infra (later phases)
DATABASE_URL=postgresql://localhost:5432/awe
REDIS_URL=redis://localhost:6379

# API
PORT=3000
RATE_LIMIT_MAX=60

# REQUIRED in any deployed environment — derives property verification tokens.
# Leaving the default lets anyone derive another property's token.
VERIFICATION_SECRET=

# Base URL the dashboard (apps/web) and admin console (apps/admin) call for data.
# Default http://localhost:3000; in docker compose the apps use http://api:3000.
API_BASE_URL=

# Bearer token that unlocks the API's /admin/* namespace and runs the admin
# console. Unset = admin API disabled and the admin app refuses to start.
STAFF_TOKEN=

# Payment rail. Unset = manual provider (everyone Free, no checkout).
STRIPE_SECRET_KEY=
